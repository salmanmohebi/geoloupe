{
  "about": "Error definitions of error panes. P = the compared data (prediction), T = the reference (truth). Each definition is a formula in the GeoLoupe formula language (geoloupe/formula.py, frontend/src/lib/formula.ts); params are named numbers the formula uses. units: 'same' = units of T, 'squared' = units of T squared, '%', '' = none, 'class' = categorical. scale: how the default colour scale is chosen.",
  "metrics": [
    {
      "id": "bias",
      "group": "Basic",
      "label": "Error",
      "symbol": "P − T",
      "formula": "P - T",
      "units": "same",
      "scale": "diverging"
    },
    {
      "id": "abs",
      "group": "Basic",
      "label": "Absolute error",
      "symbol": "|P − T|",
      "formula": "abs(P - T)",
      "units": "same",
      "scale": "sequential"
    },
    {
      "id": "sq",
      "group": "Basic",
      "label": "Squared error",
      "symbol": "(P − T)²",
      "formula": "(P - T)^2",
      "units": "squared",
      "scale": "sequential"
    },
    {
      "id": "rel",
      "group": "Relative",
      "label": "Relative error",
      "symbol": "(P − T) / T",
      "formula": "where(abs(T) <= eps, nan, 100 * (P - T) / T)",
      "units": "%",
      "scale": "diverging",
      "params": { "eps": { "label": "No value where |T| ≤", "default": 0, "units": "same" } }
    },
    {
      "id": "absrel",
      "group": "Relative",
      "label": "Absolute relative error",
      "symbol": "|P − T| / |T|",
      "formula": "where(abs(T) <= eps, nan, 100 * abs(P - T) / abs(T))",
      "units": "%",
      "scale": "sequential",
      "params": { "eps": { "label": "No value where |T| ≤", "default": 0, "units": "same" } }
    },
    {
      "id": "symrel",
      "group": "Relative",
      "label": "Symmetric relative error",
      "symbol": "2(P − T) / (|P| + |T|)",
      "formula": "where(abs(P) + abs(T) <= eps, nan, 200 * (P - T) / (abs(P) + abs(T)))",
      "units": "%",
      "scale": "diverging",
      "params": { "eps": { "label": "No value where |P| + |T| ≤", "default": 0, "units": "same" } }
    },
    {
      "id": "ratio",
      "group": "Relative",
      "label": "Ratio",
      "symbol": "P / T",
      "formula": "where(abs(T) <= eps, nan, P / T)",
      "units": "",
      "scale": "ratio",
      "params": { "eps": { "label": "No value where |T| ≤", "default": 0, "units": "same" } }
    },
    {
      "id": "logratio",
      "group": "Relative",
      "label": "Log ratio",
      "symbol": "ln(P / T)",
      "formula": "where(abs(T) <= eps, nan, log(P / T))",
      "units": "",
      "scale": "diverging",
      "params": { "eps": { "label": "No value where |T| ≤", "default": 0, "units": "same" } }
    },
    {
      "id": "norm",
      "group": "Normalised",
      "label": "Normalised error",
      "symbol": "(P − T) / s",
      "formula": "(P - T) / s",
      "units": "",
      "scale": "diverging",
      "params": {
        "s": { "label": "Scale s", "default": 1, "units": "same", "auto": "std_T" }
      }
    },
    {
      "id": "events",
      "group": "Events",
      "label": "Event agreement",
      "symbol": "P ≥ h vs T ≥ h",
      "formula": "where(P >= h, where(T >= h, 1, 3), where(T >= h, 2, 4))",
      "units": "class",
      "scale": "classes",
      "params": { "h": { "label": "Event when value ≥", "default": 1, "units": "same" } },
      "classes": [
        { "value": 1, "name": "Hit", "color": "#1a9850" },
        { "value": 2, "name": "Miss", "color": "#d73027" },
        { "value": 3, "name": "False alarm", "color": "#fdae61" },
        { "value": 4, "name": "Correct no event", "color": "#d9d9d9" }
      ]
    },
    {
      "id": "sign",
      "group": "Events",
      "label": "Sign agreement",
      "symbol": "P − c and T − c same sign",
      "formula": "where((P - c) * (T - c) >= 0, 1, 2)",
      "units": "class",
      "scale": "classes",
      "params": { "c": { "label": "Compared with", "default": 0, "units": "same" } },
      "classes": [
        { "value": 1, "name": "Same side", "color": "#4575b4" },
        { "value": 2, "name": "Opposite sides", "color": "#f46d43" }
      ]
    }
  ]
}
